# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า

# ที่เก็บฐานข้อมูล SQLite (relative กับโฟลเดอร์โปรเจกต์)
DATABASE_FILE="./data/flowbook.db"

# โฟลเดอร์เก็บไฟล์ flow JSON จริง
FLOW_STORAGE_DIR="./data/flows"

# กุญแจเซ็น session — เปลี่ยนเป็นค่าสุ่มยาว ๆ ก่อนใช้งานจริง
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# รหัสผ่านเริ่มต้นของ admin ตอน seed (เปลี่ยนทันทีหลังล็อกอินครั้งแรก)
SEED_ADMIN_ID="admin"
SEED_ADMIN_PASSWORD="flowbook123"

PORT=3000

# ตั้งเป็น true เฉพาะเมื่อเปิดเว็บผ่าน https เท่านั้น
# ถ้าเปิดผ่าน http://<ip>:3000 ต้องเป็น false ไม่งั้นเบราว์เซอร์จะทิ้ง cookie แล้วล็อกอินไม่ติด
COOKIE_SECURE=false
